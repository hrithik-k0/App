pipeline {
  agent any

  tools {
    nodejs "NodeJS_18"   // must match the name you gave in Global Tool Config
  }

  environment {
    DOCKERHUB = credentials('dockerhub-creds')
    IMAGE = "yourdockerhubusername/my-app"
    TAG = "${env.BUILD_ID}"
  }

  stages {
    stage('Checkout') {
      steps {
        git url: 'https://github.com/hrithik-k0/App.git', branch: 'master'
        sh 'ls -R'
      }
    }

    stage('Validate lockfile') {
      steps {
        // Check that package.json and package-lock.json both exist
        dir('app2') {   // change to the folder where package.json lives

        sh '''
          if [ ! -f package.json ]; then
            echo "❌ ERROR: package.json not found in workspace"
            exit 1
          fi
          if [ ! -f package-lock.json ]; then
            echo "❌ ERROR: package-lock.json not found in workspace"
            exit 1
          fi
          echo "✅ Found package.json and package-lock.json"
        '''

        // Validate that package-lock.json is proper JSON
        sh '''
          node -e "JSON.parse(require('fs').readFileSync('package-lock.json'))"
          echo "✅ package-lock.json is valid JSON"
        '''
      }
    }

    stage('Build & Test') {
      steps {
        dir('app2') {
        sh 'npm ci'
        sh 'npm test || true'
      }
    }

    stage('Build Docker Image') {
      steps {
        sh "docker build -t ${IMAGE}:${TAG} ."
      }
    }

    stage('Push Docker Image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PSW')]) {
          sh 'echo $DOCKER_PSW | docker login -u $DOCKER_USER --password-stdin'
          sh "docker push ${IMAGE}:${TAG}"
        }
      }
    }

    stage('Deploy to Kubernetes') {
      environment {
        KUBECONFIG = credentials('kubeconfig') // store kubeconfig as "Secret file"
      }
      steps {
        sh '''
          echo "Using kubeconfig from credentials"
          # write kubeconfig file for kubectl/helm
          mkdir -p $WORKSPACE/.kube
          cp $KUBECONFIG $WORKSPACE/.kube/config || true
          export KUBECONFIG=$WORKSPACE/.kube/config
          kubectl version --client
          helm upgrade --install my-app ./helm-chart \
            --namespace my-app --create-namespace \
            --set image.repository=${IMAGE} \
            --set image.tag=${TAG} \
            --wait --timeout 5m
        '''
      }
    }
  }

  post {
    success {
      echo "Deployed ${IMAGE}:${TAG}"
    }
    failure {
      echo "Pipeline failed"
    }
  }
}
  }
}